# pizzahub-client environment variables
# Copy to `.env.local` and fill in real values. Never commit real secrets.

# ---- Better Auth ----
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---- MongoDB (Better Auth adapter + business collections) ----
MONGODB_URI=
MONGODB_DB_NAME=pizzahub

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Express API ----
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Stripe (publishable key is safe to expose; secret stays server-side) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ---- ImgBB (server-side only — used by /api/upload) ----
IMGBB_API_KEY=
